version 3
run CellSharing-12-20260930-07:25:32-14717
attr configname CellSharing
attr datetime 20260930-07:25:32
attr datetimef 20260930-072532
attr experiment CellSharing
attr inifile omnetpp.ini
attr iterationvars $N=20
attr iterationvarsd N=20
attr iterationvarsf N=20-
attr measurement $N=20
attr network simu5g.simulations.nr.networks.SingleCell_Standalone
attr processid 14717
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 12
attr seedset 0
itervar N 20
config cmdenv-express-mode true
config *.numUe 20
config *.ue[*].mobility.initialX "500m + 300m * cos(2 * 3.141592653589793 * ancestorIndex(1) / 20)"
config *.ue[*].mobility.initialY "500m + 300m * sin(2 * 3.141592653589793 * ancestorIndex(1) / 20)"
config *.ue[*].app[0].sendInterval "1400 * 8 / (max(20, 150 / 20) * 1e6) * 1s"
config network simu5g.simulations.nr.networks.SingleCell_Standalone
config sim-time-limit 6s
config warmup-period 1s
config seed-set 0
config repeat 3
config **.routingRecorder.enabled false
config **.vector-recording false
config output-scalar-file results/CellSharing-N=20-r0.sca
config output-vector-file results/CellSharing-N=20-r0.vec
config *.configurator.config "xmldoc(\"demo.xml\")"
config *.carrierAggregation.componentCarrier[0].carrierFrequency 3.5GHz
config *.carrierAggregation.componentCarrier[0].numerologyIndex 1
config *.carrierAggregation.componentCarrier[0].numBands 51
config **.numBands 51
config **.ueTxPower 23dBm
config **.eNodeBTxPower 40dBm
config **.targetBler 0.01
config **.channelModel[*].shadowing false
config **.channelModel[*].fading false
config **.channelModel[*].fixedLos true
config **.channelModel[*].tolerateMaxDistViolation true
config **.mac.schedulingDisciplineUl "\"PF\""
config **.mac.schedulingDisciplineDl "\"PF\""
config *.gnb.mobility.initialX 500m
config *.gnb.mobility.initialY 500m
config **.mobility.constraintAreaMaxX 20000m
config **.mobility.constraintAreaMaxY 20000m
config **.mobility.constraintAreaMinX 0m
config **.mobility.constraintAreaMinY 0m
config **.mobility.initFromDisplayString false
config *.ue[*].servingNodeId 0
config *.ue[*].nrServingNodeId 1
config *.ue[*].numApps 1
config *.ue[*].app[0].typename UdpBasicApp
config *.ue[*].app[0].destAddresses "\"server\""
config *.ue[*].app[0].destPort "3000 + ancestorIndex(1)"
config *.ue[*].app[0].localPort 4000
config *.ue[*].app[0].messageLength 1400B
config *.ue[*].app[0].startTime "uniform(0.01s, 0.02s)"
config *.server.numApps parent.numUe
config *.server.app[*].typename UdpSink
config *.server.app[*].localPort "3000 + ancestorIndex(0)"


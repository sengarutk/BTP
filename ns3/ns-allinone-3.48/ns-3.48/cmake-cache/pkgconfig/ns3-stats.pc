exec_prefix="/usr/local/bin"
libdir="/usr/local/lib"
includedir="/usr/local/include"

Name: ns3-stats
Description: 
URL: 
Version: 3.48
Requires:  ns3-core
Requires.private: 
Cflags: -I"${includedir}"  -I/usr/include -I/usr/include/libxml2
